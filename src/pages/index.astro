---
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f7ef" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <title>PlantJarvis</title>
  </head>

  <body>
    <main>
      <header class="topbar">
        <div class="brand">
          <img id="brand-logo" class="brand-logo" src="/logo.png" alt="PlantJarvis-Logo" />
          <div>
            <h1>PlantJarvis</h1>
            <p>Damit deine Pflanzen bestens versorgt sind</p>
          </div>
        </div>
        <button id="add-open" class="button" type="button">＋ Topf hinzufügen</button>
      </header>

      <section id="home-screen">
        <div class="intro">
          <div>
            <p class="eyebrow">DEINE PFLANZEN</p>
            <h2>Wähle einen Pflanzentopf</h2>
            <p class="muted">Tippe auf einen Topf, um die Messwerte anzusehen.</p>
          </div>
          <div class="date-box">
            <div id="today">—</div>
            <div id="season">—</div>
          </div>
        </div>

        <p id="home-message" class="message">Pflanzen werden geladen …</p>
        <div id="plant-list" class="plant-list"></div>
      </section>

      <section id="detail-screen" hidden>
        <div class="detail-actions">
          <button id="back-button" class="back-button" type="button">← Zurück zu allen Pflanzen</button>
          <button id="delete-open" class="delete-button" type="button">Topf löschen</button>
        </div>

        <article id="detail-card" class="detail-card">
          <div class="plant-head">
            <div>
              <p class="eyebrow">PFLANZENDETAILS</p>
              <h2 id="plant-name">—</h2>
              <p id="pot-name" class="muted"></p>
            </div>
            <span id="plant-status" class="status">—</span>
          </div>

          <p id="detail-message" class="message"></p>
          <div id="readings" class="readings"></div>

          <footer>
            <span id="last-measurement">Letzte Messung: —</span>
            <span id="page-updated">Aktualisiert: —</span>
          </footer>
        </article>
      </section>

      <dialog id="add-dialog">
        <form id="add-form">
          <div class="dialog-head">
            <div>
              <p class="eyebrow">NEUER PFLANZENTOPF</p>
              <h2>Topf hinzufügen</h2>
            </div>
            <button id="close-dialog" class="close-button" type="button" aria-label="Schließen">×</button>
          </div>

          <label for="new-name">Name des Topfs</label>
          <input
            id="new-name"
            name="name"
            placeholder="z. B. Demo-Topf 2"
            required
            maxlength="60"
          />

          <label for="new-plant">Pflanzenart</label>
          <select id="new-plant" name="species_id" required>
            <option value="">Pflanzenarten werden geladen …</option>
          </select>

          <label for="new-device">Geräte-ID</label>
          <div class="device-row">
            <input
              id="new-device"
              name="device"
              placeholder="QR-Code scannen oder ID eingeben"
              required
              maxlength="200"
            />
            <button id="scan-button" class="button secondary" type="button">QR-Code scannen</button>
          </div>

          <video id="qr-video" playsinline muted hidden></video>
          <p id="form-message" class="form-message" aria-live="polite">
            Scanne den QR-Code am Sensor oder gib die Geräte-ID ein.
          </p>
          <button id="save-pot" class="button save-button" type="submit">Topf speichern</button>
        </form>
      </dialog>

      <dialog id="delete-dialog">
        <form id="delete-form">
          <div class="dialog-head">
            <div>
              <p class="eyebrow">ENDGÜLTIGE AKTION</p>
              <h2>Diesen Topf löschen?</h2>
            </div>
            <button
              id="delete-cancel-top"
              class="close-button"
              type="button"
              aria-label="Schließen"
            >×</button>
          </div>

          <p id="delete-pot-label" class="muted"></p>
          <p class="delete-instruction">Zur Bestätigung bitte <strong>DELETE</strong> eingeben.</p>

          <label for="delete-confirmation">Bestätigung</label>
          <input
            id="delete-confirmation"
            name="confirmation"
            autocomplete="off"
            placeholder="DELETE eingeben"
            required
          />

          <p id="delete-message" class="form-message" aria-live="polite"></p>

          <div class="delete-actions">
            <button id="delete-cancel" class="button secondary" type="button">Abbrechen</button>
            <button id="delete-confirm" class="delete-button" type="submit" disabled>
              Topf löschen
            </button>
          </div>
        </form>
      </dialog>

      <p class="small-note">Die Messwerte werden automatisch aktualisiert.</p>
    </main>

    <script>
      const SUPABASE_URL = "https://dzvzbvylebefxdhosisi.supabase.co";
      const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_GC1g6g1Wl4V18vX44-9fMw_LHisOABS";

      const VIEW_NAME = "v_base_station";
      const SPECIES_TABLE = "plant_species";
      const POT_TABLE = "pots";

      const $ = (selector) => document.querySelector(selector);

      let plants = [];
      let species = [];
      let selectedPlant = null;
      let cameraStream = null;
      let scannerControls = null;
      let scanActive = false;
      let scannedQrText = "";

      const addDialog = $("#add-dialog");
      const deleteDialog = $("#delete-dialog");

      function updateDate() {
        const now = new Date();

        $("#today").textContent = now.toLocaleDateString("de-DE", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric"
        });

        const month = now.getMonth();
        const season =
          month >= 2 && month <= 4 ? "Frühling" :
          month >= 5 && month <= 7 ? "Sommer" :
          month >= 8 && month <= 10 ? "Herbst" : "Winter";

        $("#season").textContent = `Jahreszeit: ${season}`;
      }

      function asNumber(value) {
        if (value === null || value === undefined || value === "") return null;
        const number = Number(value);
        return Number.isFinite(number) ? number : null;
      }

      function getSeasonRanges(plant) {
        const month = new Date().getMonth() + 1;
        const winter = month >= 11 || month <= 3;

        return {
          tempMin: winter ? (plant.temp_min_winter ?? plant.temp_min) : plant.temp_min,
          tempMax: winter ? (plant.temp_max_winter ?? plant.temp_max) : plant.temp_max,
          soilMin: winter ? 0 : plant.soil_min,
          soilMax: winter ? (plant.soil_max_winter ?? plant.soil_max) : plant.soil_max
        };
      }

      function getHealth(plant) {
        const ranges = getSeasonRanges(plant);
        const checks = [
          [plant.temperature, ranges.tempMin, ranges.tempMax, false],
          [plant.humidity, plant.humidity_min, plant.humidity_max, false],
          [plant.light, plant.light_min, plant.light_max, false],
          [plant.soil_moisture, ranges.soilMin, ranges.soilMax, true]
        ];

        let warning = false;

        for (const [rawValue, rawLow, rawHigh, isSoil] of checks) {
          const value = asNumber(rawValue);
          const low = asNumber(rawLow);
          const high = asNumber(rawHigh);

          if (value === null || low === null || high === null || high <= low) continue;

          if (value < low || value > high) {
            warning = true;
            const deviation = value < low ? low - value : value - high;

            if ((isSoil && value < low) || deviation > 0.2 * (high - low)) {
              return "kritisch";
            }
          }
        }

        return warning ? "achtung" : "gut";
      }

      function setAlertBadge(element, label, critical) {
        element.replaceChildren();

        if (critical) {
          const siren = document.createElement("span");
          siren.className = "siren";
          siren.setAttribute("role", "img");
          siren.setAttribute("aria-label", "Kritischer Alarm");
          siren.textContent = "🚨";
          element.append(siren, document.createTextNode(" "));
        }

        element.append(document.createTextNode(label));
      }

      function renderHome() {
        const list = $("#plant-list");
        list.replaceChildren();

        if (!plants.length) {
          $("#home-message").textContent =
            "Noch keine Pflanzentöpfe vorhanden. Füge deinen ersten Topf hinzu.";
          return;
        }

        $("#home-message").textContent = "";

        plants.forEach((plant, index) => {
          const state = getHealth(plant);
          const card = document.createElement("button");
          card.type = "button";
          card.className = "plant-tile";

          if (state === "kritisch") card.classList.add("critical");

          const icon = document.createElement("span");
          icon.className = "tile-icon";
          icon.textContent = "🪴";

          const info = document.createElement("span");
          info.className = "tile-info";

          const name = document.createElement("strong");
          name.textContent = plant.pflanze || plant.name || "Pflanze";

          const potName = document.createElement("small");
          potName.textContent = plant.name ? `Topf: ${plant.name}` : "Pflanzentopf";

          const summary = document.createElement("span");
          summary.className = "tile-summary";

          const temperature = asNumber(plant.temperature);
          const soil = asNumber(plant.soil_moisture);

          summary.textContent =
            `Temperatur ${temperature === null ? "—" : `${temperature.toFixed(1)} °C`} · Bodenfeuchtigkeit ${soil === null ? "—" : `${soil}%`}`;

          info.append(name, potName, summary);

          const badge = document.createElement("span");
          badge.className = `tile-status ${state}`;
          setAlertBadge(
            badge,
            state === "kritisch" ? "Kritisch" : state === "achtung" ? "Prüfen" : "Alles gut",
            state === "kritisch"
          );

          const arrow = document.createElement("span");
          arrow.className = "tile-arrow";
          arrow.textContent = "›";
          arrow.setAttribute("aria-hidden", "true");

          card.append(icon, info, badge, arrow);
          card.addEventListener("click", () => showPlant(index));
          list.append(card);
        });
      }

      function populateSpeciesDropdown() {
        const select = $("#new-plant");
        const currentValue = select.value;

        select.replaceChildren();

        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = species.length
          ? "Pflanzenart auswählen"
          : "Keine Pflanzenarten gefunden";
        select.append(placeholder);

        for (const item of species) {
          const option = document.createElement("option");
          option.value = String(item.id);
          option.textContent = item.name_de || item.name_lat || `Pflanzenart ${item.id}`;
          select.append(option);
        }

        if (species.some((item) => String(item.id) === currentValue)) {
          select.value = currentValue;
        }
      }

      async function loadSpecies() {
        const select = $("#new-plant");
        select.innerHTML = '<option value="">Pflanzenarten werden geladen …</option>';

        try {
          const response = await fetch(
            `${SUPABASE_URL}/rest/v1/${SPECIES_TABLE}?select=id,name_de,name_lat&order=name_de.asc`,
            { headers: { apikey: SUPABASE_PUBLISHABLE_KEY } }
          );

          if (!response.ok) {
            throw new Error(`${response.status}: ${await response.text()}`);
          }

          species = await response.json();
          populateSpeciesDropdown();

          if (!species.length) {
            $("#form-message").textContent = "In plant_species wurden keine Arten gefunden.";
          }
        } catch (error) {
          console.error(error);
          species = [];
          select.innerHTML =
            '<option value="">Pflanzenarten konnten nicht geladen werden</option>';
          $("#form-message").textContent =
            `Pflanzenarten konnten nicht geladen werden: ${error.message}`;
        }
      }

      function addReading(label, rawValue, unit, rawLow, rawHigh, decimals = 0) {
        const value = asNumber(rawValue);
        const low = asNumber(rawLow);
        const high = asNumber(rawHigh);

        const card = document.createElement("article");
        card.className = "reading";

        const top = document.createElement("div");
        top.className = "reading-top";

        const title = document.createElement("div");
        title.className = "reading-label";
        title.textContent = label;

        const displayedValue = document.createElement("strong");
        displayedValue.className = "reading-value";
        displayedValue.textContent = value === null ? "—" : `${value.toFixed(decimals)} ${unit}`;

        top.append(title, displayedValue);

        const gauge = document.createElement("div");
        gauge.className = "gauge";
        gauge.setAttribute("role", "img");

        const target = document.createElement("div");
        target.className = "target";

        const marker = document.createElement("div");
        marker.className = "marker";

        const legend = document.createElement("div");
        legend.className = "gauge-legend";

        if (low !== null && high !== null && high > low) {
          const span = high - low;
          const axisMin = Math.max(0, low - span * 0.5);
          const axisMax = high + span * 0.5;
          const axisSpan = axisMax - axisMin;

          target.style.left = `${((low - axisMin) / axisSpan) * 100}%`;
          target.style.width = `${((high - low) / axisSpan) * 100}%`;
          gauge.append(target);

          if (value !== null) {
            const position = Math.max(
              0,
              Math.min(100, ((value - axisMin) / axisSpan) * 100)
            );

            marker.style.left = `${position}%`;
            gauge.append(marker);
            gauge.setAttribute(
              "aria-label",
              `${label}: ${value} ${unit}; Zielbereich ${low} bis ${high} ${unit}`
            );

            if (value < low || value > high) card.classList.add("out-of-range");
          } else {
            gauge.setAttribute(
              "aria-label",
              `${label}: kein Messwert; Zielbereich ${low} bis ${high} ${unit}`
            );
          }

          const targetLabel = document.createElement("span");
          targetLabel.textContent = `Ziel: ${low}–${high} ${unit}`;

          const valueLabel = document.createElement("span");
          valueLabel.textContent = value === null ? "Messwert: —" : "◆ Messwert";

          legend.append(targetLabel, valueLabel);
        } else {
          gauge.setAttribute("aria-label", `${label}: Zielbereich nicht verfügbar`);
          legend.textContent = "Zielbereich nicht verfügbar";
        }

        card.append(top, gauge, legend);
        $("#readings").append(card);
      }

      function showPlant(index) {
        selectedPlant = plants[index];
        if (!selectedPlant) return;

        const state = getHealth(selectedPlant);

        $("#home-screen").hidden = true;
        $("#detail-screen").hidden = false;
        $("#plant-name").textContent =
          selectedPlant.pflanze || selectedPlant.name || "Pflanze";
        $("#pot-name").textContent =
          selectedPlant.name ? `Topf: ${selectedPlant.name}` : "";

        const badge = $("#plant-status");
        badge.className = `status ${state}`;

        setAlertBadge(
          badge,
          state === "kritisch" ? "KRITISCH" :
            state === "achtung" ? "PFLANZE PRÜFEN" : "ALLES GUT",
          state === "kritisch"
        );

        $("#detail-card").classList.toggle("critical", state === "kritisch");

        const age = asNumber(selectedPlant.age_min);

        if (age === null || age < 0) {
          $("#last-measurement").textContent = "Letzte Messung: Zeit nicht verfügbar";
        } else {
          const measured = new Date(Date.now() - age * 60000);
          $("#last-measurement").textContent =
            `Letzte Messung: ${measured.toLocaleString("de-DE", {
              dateStyle: "medium",
              timeStyle: "short"
            })} (vor etwa ${age} Min.)`;
        }

        const ranges = getSeasonRanges(selectedPlant);
        $("#readings").replaceChildren();

        addReading("Temperatur", selectedPlant.temperature, "°C", ranges.tempMin, ranges.tempMax, 1);
        addReading("Luftfeuchtigkeit", selectedPlant.humidity, "%", selectedPlant.humidity_min, selectedPlant.humidity_max);
        addReading("Licht", selectedPlant.light, "lx", selectedPlant.light_min, selectedPlant.light_max);
        addReading("Bodenfeuchtigkeit", selectedPlant.soil_moisture, "%", ranges.soilMin, ranges.soilMax);

        $("#detail-message").textContent =
          age !== null && age > 180
            ? `Achtung: Die letzte Messung ist bereits etwa ${age} Minuten alt.`
            : "";

        $("#page-updated").textContent =
          `Aktualisiert: ${new Date().toLocaleTimeString("de-DE", {
            hour: "2-digit",
            minute: "2-digit"
          })}`;
      }

      async function loadPlants() {
        updateDate();

        try {
          const response = await fetch(
            `${SUPABASE_URL}/rest/v1/${VIEW_NAME}?select=*&order=name.asc`,
            { headers: { apikey: SUPABASE_PUBLISHABLE_KEY } }
          );

          if (!response.ok) {
            throw new Error(`${response.status}: ${await response.text()}`);
          }

          plants = await response.json();
          renderHome();

          if (selectedPlant && !$("#detail-screen").hidden) {
            const selectedId = selectedPlant.pot_id || selectedPlant.device_id;
            const index = plants.findIndex(
              (plant) => (plant.pot_id || plant.device_id) === selectedId
            );

            if (index >= 0) {
              showPlant(index);
            } else {
              selectedPlant = null;
              $("#detail-screen").hidden = true;
              $("#home-screen").hidden = false;
            }
          }
        } catch (error) {
          console.error(error);
          $("#home-message").textContent =
            `Pflanzen konnten nicht geladen werden: ${error.message}`;
        }
      }

      function stopScanner() {
        scanActive = false;

        if (scannerControls) {
          scannerControls.stop();
          scannerControls = null;
        }

        if (cameraStream) {
          cameraStream.getTracks().forEach((track) => track.stop());
          cameraStream = null;
        }

        $("#qr-video").hidden = true;
      }

      function deviceIdFromQr(rawValue) {
        const text = String(rawValue || "").trim();

        try {
          const url = new URL(text);
          return url.searchParams.get("device_id") ||
            url.searchParams.get("id") ||
            url.searchParams.get("t") ||
            text;
        } catch {
          return text;
        }
      }

      async function startNativeQrScanner(video) {
        if (!window.BarcodeDetector) return false;

        const detector = new BarcodeDetector({ formats: ["qr_code"] });

        cameraStream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: { facingMode: { ideal: "environment" } }
        });

        video.srcObject = cameraStream;
        video.hidden = false;
        await video.play();
        scanActive = true;

        const scan = async () => {
          if (!scanActive) return;

          try {
            const codes = await detector.detect(video);

            if (codes.length) {
              scannedQrText = String(codes[0].rawValue || "").trim();
              $("#new-device").value = deviceIdFromQr(scannedQrText);
              $("#form-message").textContent =
                "QR-Code erkannt. Geräte-ID wurde eingetragen.";
              stopScanner();
              return;
            }
          } catch (error) {
            console.warn("QR-Erkennung:", error);
          }

          if (scanActive) requestAnimationFrame(scan);
        };

        requestAnimationFrame(scan);
        return true;
      }

      async function startLibraryQrScanner(video) {
        const dynamicImport = new Function("url", "return import(url)");
        const library = await dynamicImport(
          "https://cdn.jsdelivr.net/npm/@zxing/browser@0.1.5/+esm"
        );

        const Reader = library.BrowserMultiFormatReader;
        if (!Reader) throw new Error("QR-Scanner-Bibliothek konnte nicht geladen werden.");

        const reader = new Reader();
        video.hidden = false;
        scanActive = true;

        scannerControls = await reader.decodeFromVideoDevice(
          undefined,
          video,
          (result, error) => {
            if (result && scanActive) {
              scannedQrText = String(result.getText() || "").trim();
              $("#new-device").value = deviceIdFromQr(scannedQrText);
              $("#form-message").textContent =
                "QR-Code erkannt. Geräte-ID wurde eingetragen.";
              stopScanner();
            }

            if (error && error.name !== "NotFoundException") {
              console.debug("QR-Scan:", error);
            }
          }
        );

        return true;
      }

      $("#add-open").addEventListener("click", async () => {
        $("#form-message").textContent =
          "Scanne den QR-Code am Sensor oder gib die Geräte-ID ein.";
        addDialog.showModal();
        await loadSpecies();
      });

      $("#close-dialog").addEventListener("click", () => {
        stopScanner();
        addDialog.close();
      });

      $("#back-button").addEventListener("click", () => {
        $("#detail-screen").hidden = true;
        $("#home-screen").hidden = false;
      });

      $("#scan-button").addEventListener("click", async () => {
        const video = $("#qr-video");
        const button = $("#scan-button");

        if (!navigator.mediaDevices?.getUserMedia) {
          $("#form-message").textContent =
            "Kamerazugriff ist nicht verfügbar. Öffne die Website über HTTPS oder gib die Geräte-ID manuell ein.";
          return;
        }

        button.disabled = true;
        $("#form-message").textContent = "Kamera wird gestartet …";

        try {
          const nativeScannerStarted = await startNativeQrScanner(video);

          if (!nativeScannerStarted) {
            await startLibraryQrScanner(video);
          }

          $("#form-message").textContent =
            "Richte die Kamera auf den QR-Code am Sensor.";
        } catch (error) {
          console.error(error);
          stopScanner();
          $("#form-message").textContent =
            "QR-Scanner konnte nicht gestartet werden. Erlaube den Kamerazugriff oder gib die Geräte-ID manuell ein.";
        } finally {
          button.disabled = false;
        }
      });

      $("#new-device").addEventListener("input", () => {
        scannedQrText = "";
      });

      $("#add-form").addEventListener("submit", async (event) => {
        event.preventDefault();

        const saveButton = $("#save-pot");
        const message = $("#form-message");
        const name = $("#new-name").value.trim();
        const speciesId = $("#new-plant").value;
        const deviceId = $("#new-device").value.trim();

        if (!name || !speciesId || !deviceId) {
          message.textContent =
            "Bitte gib einen Topfnamen, eine Pflanzenart und eine Geräte-ID ein.";
          return;
        }

        saveButton.disabled = true;
        message.textContent = "Topf wird gespeichert …";

        try {
          const response = await fetch(`${SUPABASE_URL}/rest/v1/${POT_TABLE}`, {
            method: "POST",
            headers: {
              apikey: SUPABASE_PUBLISHABLE_KEY,
              "Content-Type": "application/json",
              Prefer: "return=minimal"
            },
            body: JSON.stringify({
              name,
              species_id: Number(speciesId),
              device_id: deviceId,
              qr_code: scannedQrText || deviceId
            })
          });

          if (!response.ok) {
            throw new Error(`${response.status}: ${await response.text()}`);
          }

          stopScanner();
          $("#add-form").reset();
          scannedQrText = "";
          addDialog.close();

          await loadPlants();

          $("#home-screen").hidden = false;
          $("#detail-screen").hidden = true;
        } catch (error) {
          console.error(error);
          message.textContent = `Speichern fehlgeschlagen: ${error.message}`;
        } finally {
          saveButton.disabled = false;
        }
      });

      $("#delete-open").addEventListener("click", () => {
        if (!selectedPlant) return;

        const label =
          selectedPlant.name || selectedPlant.pflanze || "Diesen Topf";
        $("#delete-pot-label").textContent = `Du bist dabei, „${label}“ zu löschen.`;
        $("#delete-confirmation").value = "";
        $("#delete-confirm").disabled = true;
        $("#delete-message").textContent = "";
        deleteDialog.showModal();
      });

      $("#delete-cancel").addEventListener("click", () => deleteDialog.close());
      $("#delete-cancel-top").addEventListener("click", () => deleteDialog.close());

      $("#delete-confirmation").addEventListener("input", (event) => {
        $("#delete-confirm").disabled = event.target.value.trim() !== "DELETE";
      });

      $("#delete-form").addEventListener("submit", async (event) => {
        event.preventDefault();

        const message = $("#delete-message");
        const confirmation = $("#delete-confirmation").value.trim();
        const confirmButton = $("#delete-confirm");

        if (confirmation !== "DELETE") {
          message.textContent = "Gib DELETE genau so ein, um zu bestätigen.";
          return;
        }

        const potId = selectedPlant?.pot_id;

        if (!potId) {
          message.textContent = "Der Topf konnte nicht identifiziert werden (pot_id fehlt).";
          return;
        }

        confirmButton.disabled = true;
        message.textContent = "Topf wird gelöscht …";

        try {
          const response = await fetch(
            `${SUPABASE_URL}/rest/v1/${POT_TABLE}?id=eq.${encodeURIComponent(potId)}`,
            {
              method: "DELETE",
              headers: {
                apikey: SUPABASE_PUBLISHABLE_KEY,
                Prefer: "return=minimal"
              }
            }
          );

          if (!response.ok) {
            throw new Error(`${response.status}: ${await response.text()}`);
          }

          deleteDialog.close();
          selectedPlant = null;
          $("#detail-screen").hidden = true;
          $("#home-screen").hidden = false;
          await loadPlants();
        } catch (error) {
          console.error(error);
          message.textContent = `Löschen fehlgeschlagen: ${error.message}`;
          confirmButton.disabled = false;
        }
      });

      for (const dialog of [addDialog, deleteDialog]) {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) {
            stopScanner();
            dialog.close();
          }
        });
      }

      $("#brand-logo").addEventListener("error", () => {
        console.error("Logo nicht gefunden. Prüfe, ob die Datei unter public/logo.png liegt.");
      });

      loadPlants();
      loadSpecies();
      setInterval(loadPlants, 60000);
    </script>

    <style is:global>
      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 34px 20px;
        min-height: 100vh;
        background: #f3f7ef;
        color: #203629;
        font-family: system-ui, sans-serif;
      }

      button, input, select { font: inherit; }
      [hidden] { display: none !important; }
      main { max-width: 1080px; margin: 0 auto; }

      .topbar, .brand, .intro, .plant-head, footer, .dialog-head, .device-row,
      .detail-actions, .delete-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .topbar { margin-bottom: 46px; }
      .brand { justify-content: flex-start; gap: 20px; }

      .brand-logo {
        display: block;
        width: 112px;
        height: 112px;
        object-fit: contain;
        border-radius: 20px;
      }

      h1, h2, p { margin: 0; }
      h1 { font-size: 30px; letter-spacing: -.6px; }
      .brand p, .muted { margin-top: 6px; color: #718074; }
      .intro { margin-bottom: 25px; }
      h2 { font-size: clamp(26px, 4vw, 35px); }

      .eyebrow {
        margin-bottom: 8px;
        color: #6b886d;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
      }

      .button {
        border: 0;
        border-radius: 14px;
        padding: 13px 18px;
        background: #38734e;
        color: white;
        cursor: pointer;
        font-weight: 700;
        box-shadow: 0 6px 16px #38734e22;
      }

      .button:hover { background: #2c5d3e; }
      .button:disabled { opacity: .6; cursor: wait; }
      .date-box { color: #54715c; line-height: 1.8; text-align: right; }
      .message { padding: 15px 0; color: #68796c; }

      .plant-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .plant-tile {
        position: relative;
        display: flex;
        align-items: center;
        gap: 17px;
        width: 100%;
        min-height: 132px;
        padding: 23px;
        overflow: hidden;
        border: 1px solid #e1e9dd;
        border-radius: 22px;
        background: linear-gradient(135deg, #fff 0%, #f8fbf5 100%);
        color: #203629;
        text-align: left;
        cursor: pointer;
        box-shadow: 0 10px 28px #26462b0c;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      }

      .plant-tile::before {
        position: absolute;
        inset: 0 auto 0 0;
        width: 6px;
        background: #8db583;
        content: "";
      }

      .plant-tile:hover, .plant-tile:focus-visible {
        transform: translateY(-3px);
        border-color: #9dbb96;
        box-shadow: 0 16px 35px #26462b17;
      }

      .plant-tile:focus-visible {
        outline: 3px solid #75a66e;
        outline-offset: 3px;
      }

      .plant-tile.critical { animation: critical-blink 1s infinite; }

      .tile-icon {
        display: grid;
        flex: 0 0 58px;
        width: 58px;
        height: 58px;
        place-items: center;
        border-radius: 18px;
        background: #eaf3e5;
        font-size: 31px;
      }

      .tile-info { display: grid; flex: 1; gap: 6px; min-width: 0; }
      .tile-info strong { font-size: 19px; }
      .tile-info small, .tile-summary { color: #718074; overflow-wrap: anywhere; }
      .tile-summary { font-size: 12px; }

      .tile-status, .status {
        padding: 9px 12px;
        border-radius: 99px;
        background: #e9f5e7;
        color: #347044;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
      }

      .tile-status.achtung, .status.achtung {
        background: #fff2d9;
        color: #8a5a00;
      }

      .tile-status.kritisch, .status.kritisch {
        background: #c83131;
        color: white;
      }

      .tile-arrow { color: #78917b; font-size: 30px; line-height: 1; }

      .siren {
        display: inline-block;
        transform-origin: center;
        animation: siren-flash .65s steps(2, end) infinite;
      }

      @keyframes siren-flash {
        0%, 100% { opacity: 1; filter: drop-shadow(0 0 2px #e00000); }
        50% { opacity: .35; filter: drop-shadow(0 0 9px #ff0000); }
      }

      @keyframes critical-blink {
        0%, 100% { background-color: #fff; box-shadow: 0 0 0 2px #d52626; }
        50% { background-color: #ffe1e1; box-shadow: 0 0 0 5px #d52626; }
      }

      .detail-actions { margin-bottom: 15px; }
      .back-button {
        padding: 8px 0;
        border: 0;
        background: transparent;
        color: #38734e;
        cursor: pointer;
        font-weight: 750;
      }

      .delete-button {
        border: 0;
        border-radius: 14px;
        padding: 13px 18px;
        background: #b83232;
        color: white;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
      }

      .delete-button:hover { background: #922727; }
      .delete-button:disabled { opacity: .5; cursor: not-allowed; }

      .detail-card {
        padding: 32px;
        border: 1px solid #e2eadf;
        border-radius: 26px;
        background: white;
        box-shadow: 0 12px 36px #26462b12;
      }

      .detail-card.critical { animation: critical-blink 1s infinite; }
      .plant-head { padding-bottom: 23px; border-bottom: 1px solid #e8eee5; }

      .readings {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin: 23px 0 27px;
      }

      .reading {
        padding: 21px;
        border: 1px solid #edf1e9;
        border-radius: 19px;
        background: #f8faf6;
      }

      .reading.out-of-range {
        border-color: #e5a4a4;
        background: #fff8f7;
      }

      .reading-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .reading-label { color: #718074; font-weight: 650; }
      .reading-value { color: #203629; font-size: 25px; white-space: nowrap; }

      .gauge {
        position: relative;
        height: 15px;
        margin: 25px 8px 13px;
        border-radius: 99px;
        background: linear-gradient(90deg, #f1d9d4, #f5edda 50%, #f1d9d4);
        box-shadow: inset 0 1px 3px #263b2c1c;
      }

      .target {
        position: absolute;
        top: 0;
        height: 100%;
        border: 1px solid #72a56e;
        border-radius: 99px;
        background: #9dcc91;
        box-shadow: 0 0 0 3px #9dcc9128;
      }

      .marker {
        position: absolute;
        top: 50%;
        width: 20px;
        height: 20px;
        border: 3px solid white;
        border-radius: 6px;
        background: #275f38;
        box-shadow: 0 1px 5px #122f1b88;
        transform: translate(-50%, -50%) rotate(45deg);
      }

      .out-of-range .marker { background: #c33b32; }

      .gauge-legend {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        color: #718071;
        font-size: 12px;
      }

      footer {
        flex-wrap: wrap;
        padding-top: 18px;
        border-top: 1px solid #e6ece3;
        color: #54715c;
      }

      .small-note {
        margin-top: 25px;
        color: #829084;
        font-size: 13px;
        text-align: center;
      }

      dialog {
        width: min(560px, calc(100% - 28px));
        padding: 27px;
        border: 1px solid #dfe8dc;
        border-radius: 23px;
        color: #203629;
        box-shadow: 0 24px 80px #17291c44;
      }

      dialog::backdrop { background: #14201888; }
      .dialog-head { margin-bottom: 22px; }

      .close-button {
        border: 0;
        background: transparent;
        color: #617164;
        font-size: 30px;
        cursor: pointer;
      }

      form > label { display: block; margin: 14px 0 7px; font-weight: 700; }

      form input, form select {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccd8ca;
        border-radius: 10px;
        background: white;
        color: #203629;
      }

      form input:focus, form select:focus {
        outline: 3px solid #9dcc914c;
        border-color: #75a66e;
      }

      .device-row input { min-width: 0; }
      .secondary { flex: 0 0 auto; background: #e5eee1; color: #315f40; box-shadow: none; }
      .form-message { min-height: 24px; margin: 11px 0; color: #68796c; font-size: 14px; }
      .delete-instruction { margin-top: 16px; }

      #qr-video {
        width: 100%;
        max-height: 300px;
        margin-top: 10px;
        border-radius: 14px;
        background: #17291c;
        object-fit: cover;
      }

      .save-button { width: 100%; margin-top: 8px; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: .01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
        }
      }

      @media (max-width: 700px) {
        body { padding: 22px 14px; }
        .topbar, .intro, .plant-head { align-items: flex-start; flex-direction: column; }
        .brand-logo { width: 88px; height: 88px; }
        .date-box { text-align: left; }
        .plant-list, .readings { grid-template-columns: 1fr; }
        .detail-card { padding: 22px; }
      }

      @media (max-width: 460px) {
        .topbar { gap: 20px; }
        .brand { gap: 13px; }
        .brand-logo { width: 72px; height: 72px; }
        .plant-tile { flex-wrap: wrap; padding: 18px; }
        .tile-status { margin-left: 74px; }
        .device-row, .detail-actions, .delete-actions { align-items: stretch; flex-direction: column; }
      }
    </style>
  </body>
</html>
