---
const readings = [
  { label: "Temperature", value: "22.4 °C", range: "Target: 18–26 °C", percent: 55 },
  { label: "Air humidity", value: "58%", range: "Target: 40–70%", percent: 60 },
  { label: "Light", value: "1,240 lx", range: "Target: 800–2,000 lx", percent: 48 },
  { label: "Soil moisture", value: "42%", range: "Target: 30–60%", percent: 40 },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PlantJarvis</title>
  </head>
  <body>
    <main>
      <header>
        <div class="brand"><span class="leaf">🌿</span><div><h1>PlantJarvis</h1><p>Your plants, happily monitored</p></div></div>
        <div class="date">🌼 Spring · 25 November 2026</div>
      </header>

      <section class="plant">
        <div class="plant-title">
          <div><p class="eyebrow">YOUR PLANT</p><h2>Monstera</h2><p class="muted">Living room · Example plant</p></div>
          <span class="status">● Looking good</span>
        </div>

        <div class="readings">
          {readings.map((item) => (
            <article class="reading">
              <div class="reading-top"><span>{item.label}</span><strong>{item.value}</strong></div>
              <div class="track"><span style={`width:${item.percent}%`}></span></div>
              <small>{item.range}</small>
            </article>
          ))}
        </div>

        <footer><span>🕒 Example: last updated at 18:11</span><span>🐝 Growing nicely!</span></footer>
      </section>

      <p class="note">Demo readings only. Connect Supabase to show your real plant-pot data.</p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f3f7ef; color: #203629; font-family: system-ui, sans-serif; }
  main { max-width: 900px; margin: 48px auto; padding: 0 22px; }
  header, .brand, .plant-title, .reading-top, footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  header { margin-bottom: 30px; }
  .brand { justify-content: flex-start; }
  .leaf { font-size: 42px; }
  h1, h2, p { margin: 0; }
  h1 { font-size: 27px; }
  .brand p, .muted, .note { color: #6c7e70; }
  .date { color: #54715c; }
  .plant { background: white; border: 1px solid #e2eadf; border-radius: 24px; padding: 30px; box-shadow: 0 12px 36px #26462b12; }
  .eyebrow { color: #6b886d; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 7px; }
  h2 { font-size: 32px; margin-bottom: 5px; }
  .status { background: #e9f5e7; color: #347044; border-radius: 99px; padding: 10px 14px; font-size: 14px; }
  .readings { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 32px 0; }
  .reading { background: #f8faf6; border-radius: 16px; padding: 20px; }
  .reading-top { margin-bottom: 15px; }
  .reading-top strong { font-size: 22px; }
  .track { height: 11px; background: #e4eadf; border-radius: 20px; overflow: hidden; }
  .track span { display: block; height: 100%; background: #75a76e; border-radius: 20px; }
  small { display: block; color: #718071; margin-top: 10px; }
  footer { border-top: 1px solid #e6ece3; padding-top: 20px; color: #54715c; flex-wrap: wrap; }
  .note { text-align: center; font-size: 13px; margin-top: 18px; }
  @media (max-width: 600px) { main { margin: 24px auto; } header, .plant-title { align-items: flex-start; flex-direction: column; } .readings { grid-template-columns: 1fr; } .plant { padding: 22px; } }
</style>
